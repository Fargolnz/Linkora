Profile {
    Cover { image: "./assets/cover.svg" }
    Logo { image: "./assets/logo.jpg" }
    Name { title: "Seyyedeh Fargol Nazemzadeh", subtitle: "Developer & Designer" }
    Bio { text: "Building Linkora — a DSL for customizable link-in-bio pages." }
}

Title { title: "My Links Customized", align: left, titleColor: "#c7006e" }

Link {
    title: "My GitHub"
    url: "https://github.com/Fargolnz"
}

Link {
    title: "My GitHub, But Customized"
    url: "https://github.com/Fargolnz"
    align: left
    titleColor: "#c7006e"
    backgroundColor: "#ffa8d8"
    borderColor: "#f63ba2"
    shape: pill
}

Link { title: "لینکدین من", url: "https://www.linkedin.com/in/seyyedeh-fargol-nazemzadeh" }

Link { title: "لینکدین من شخصی‌سازی شده", url: "https://www.linkedin.com/in/seyyedeh-fargol-nazemzadeh", align: right, titleColor: "#4F46E5", backgroundColor: "#FFFFFF", borderColor: "#4F46E5", shape: sharp }

Text { text: "A short paragraph describing my work and interests." }

Title { title: "Social Media" }

SocialMedia {
    columns: 3
    SocialMediaItem { service: instagram, url: "https://instagram.com" }
    SocialMediaItem { service: telegram, url: "https://t.me/linkora" }
    SocialMediaItem { service: youtube, url: "https://youtube.com" }
    SocialMediaItem { service: tiktok, url: "https://tiktok.com" }
    SocialMediaItem { service: x, url: "https://x.com" }
    SocialMediaItem { service: linkedin, url: "https://www.linkedin.com/in/seyyedeh-fargol-nazemzadeh" }
    SocialMediaItem { service: github, url: "https://github.com/Fargolnz" }
    SocialMediaItem { service: spotify, url: "https://open.spotify.com" }
    SocialMediaItem { service: twitch, url: "https://www.twitch.tv" }
    SocialMediaItem { service: pinterest, url: "https://www.pinterest.com" }
    SocialMediaItem { service: facebook, url: "https://www.facebook.com" }
    SocialMediaItem { service: patreon, url: "https://www.patreon.com" }
}

Title { title: "Messaging" }

SocialNetwork {
    columns: 3
    SocialNetworkItem { service: telegram, url: "https://t.me/linkora" }
    SocialNetworkItem { service: whatsapp, url: "https://wa.me/1234567890" }
    SocialNetworkItem { service: discord, url: "https://discord.gg/linkora" }
    SocialNetworkItem { service: skype, url: "https://join.skype.com/linkora" }
    SocialNetworkItem { service: line, url: "https://line.me/ti/p/linkora" }
    SocialNetworkItem { service: viber, url: "https://viber.me/linkora" }
    SocialNetworkItem { service: kik, url: "https://kik.me/linkora" }
    SocialNetworkItem { service: facebookMessenger, url: "https://m.me/linkora" }
    SocialNetworkItem { service: bale, url: "https://ble.ir/linkora" }
    SocialNetworkItem { service: eitaa, url: "https://eitaa.com/linkora" }
    SocialNetworkItem { service: rubika, url: "https://rubika.ir/linkora" }
}


Title { title: "Contact" }

Contact {
    columns: 1
    ContactItem { service: mobile, value: "+1 234 567 8901" }
    ContactItem { service: phone, value: "+1 234 567 8901" }
    ContactItem { service: email, value: "hi@example.com" }
    ContactItem { service: sms, value: "+1 234 567 8901" }
    ContactItem { service: website, value: "https://example.com" }
}


Title { title: "Address" }

Address {
    columns: 2
    address: "Tehran, Iran"
    addressColor: "#111111"
    AddressItem { service: googleMap, url: "https://maps.google.com/?q=Tehran" }
    AddressItem { service: waze, url: "https://waze.com/ul?q=Tehran" }
    AddressItem { service: neshan, url: "https://neshan.org/maps/@35.689,51.389" }
    AddressItem { service: balad, url: "https://balad.ir/place?q=Tehran" }
}


Title { title: "Gallery" }

Image {
    columns: 2
    shape: rounded
    imageShadow: true
    ImageItem { image: "./assets/single-1.jpg", title: "Scenery", description: "A scenery image." }
    ImageItem { image: "./assets/single-2.jpg", title: "Scenery" }
}


Title { title: "Highlights" }

Image {
    displayMode: slider
    shape: slightlyRounded
    ImageItem { image: "./assets/slider-1.jpg", title: "Slide One", description: "First highlight slide." }
    ImageItem { image: "./assets/slider-2.jpg", title: "Slide Two" }
    ImageItem { image: "./assets/slider-3.jpg" }
}


Title { title: "Promotions" }

Banner {
    columns: 2
    shape: rounded
    BannerItem {
        image: "./assets/banner-1.png"
        url: "https://example.com/banner-1"
        title: "Summer Sale"
        description: "Up to 50% off on selected items."
    }
    BannerItem {
        image: "./assets/slider-2.jpg"
        url: "https://example.com/banner-2"
        title: "New Collection"
        description: "Check out the latest arrivals."
    }
    BannerItem {
        image: "./assets/banner-2.jpg"
        url: "https://example.com/banner-3"
        title: "Featured"
    }
}


Title { title: "Videos" }

Video {
    url: "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    thumbnail: "./assets/slider-3.jpg"
}

Video {
    url: "https://www.aparat.com/v/abc123" 
    shape: slightlyRounded
}


Title { title: "FAQ" }

FAQ {
    shape: rounded
    FAQItem { question: "What is Linkora?", answer: "A DSL for building customizable link-in-bio pages." }
    FAQItem { question: "Can I customize each block?", answer: "Yes — every block supports colors, shapes, and layout options so your page matches your style." }
}


Title { title: "Launch Countdown" }

Countdown {
    date: "2026/10/05"
    time: "23:59"
    language: en
    expiredText: "Linkora is live!"
}

